# Butique da Carne — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha com suas credenciais
# NUNCA commite o arquivo .env.local no Git

# Supabase — encontre em: Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# Opcional: URL do site em produção (usada pelo PWA manifest)
VITE_APP_URL=https://seu-projeto.vercel.app
